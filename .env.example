# ─── Database ─────────────────────────────────────────────────────────────────
# Relative to backend/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required in production: the server refuses to start without it.
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (comma-separated for multiple origins) ──────────────────────────────
CORS_ORIGIN="http://localhost:5173,http://localhost:5200"
# Production example: CORS_ORIGIN="https://gemmagf.github.io"

# ─── Frontend (Vite, build-time) ──────────────────────────────────────────────
# Local dev uses the Vite proxy, nothing needed.
# GitHub Pages demo build:   VITE_DEMO_MODE=true  VITE_BASE_URL=/coffe_logic/
# Hosted build with backend: VITE_API_URL=https://cafgic-api.onrender.com/api
