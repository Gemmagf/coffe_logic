# ─── Database ─────────────────────────────────────────────────────────────────
# Local:
DATABASE_URL="file:./prisma/dev.db"
# Render (production):
# DATABASE_URL="file:./prisma/prod.db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (comma-separated for multiple origins) ──────────────────────────────
# Local:
CORS_ORIGIN="http://localhost:5173,http://localhost:5200"
# Render (production) — add GitHub Pages URL:
# CORS_ORIGIN="https://gemmagf.github.io"

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Local: not needed (uses Vite proxy)
# GitHub Pages build (GitHub secret VITE_API_URL):
# VITE_API_URL="https://cafgic-api.onrender.com/api"
# VITE_BASE_URL="/coffe_logic/"
